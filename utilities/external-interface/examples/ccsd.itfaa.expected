load CSE1:ec[ck]
.R1:ec[ai] += -2 * T2:eecc[acki] CSE1:ec[ck]
drop CSE1:ec[ck]
load CSE2:ec[ck]
.R1:ec[ai] += T2:eecc[acki] CSE2:ec[ck]
drop CSE2:ec[ck]
drop T2:eecc[acki]
store R1:ec[ai]

for [j]:
