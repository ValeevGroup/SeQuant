.R1:ec[ai] += -2 * CSE1:ec[cj] T2:eecc[acij]
.R1:ec[ai] += CSE1:ec[cj] T2:eecc[acji]
drop T2:eecc[acji]
drop CSE1:ec[cj]
load f:ee[ab]
