.R1:ec[ai] += f:ee[ab] T1:ec[bi]
drop T1:ec[bi]
drop f:ee[ab]
load f:ec[ai]
.R1:ec[ai] += f:ec[ai]
load T2:eecc[abij]
.R1:ec[ai] += 2 * f:ec[bj] T2:eecc[abij]
.R1:ec[ai] += -1 * f:ec[bj] T2:eecc[abji]
drop T2:eecc[abji]
drop f:ec[bj]
load f:cc[ji]
