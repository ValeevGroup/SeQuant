.R1:ec[ai] += f:ee[ab] T1:ec[bi]
drop T1:ec[bi]
drop f:ee[ab]
load f:ec[bj]
load T2:eecc[abji]
.R1:ec[ai] += -1 * f:ec[bj] T2:eecc[abji]
drop T2:eecc[abji]
drop f:ec[bj]
alloc I:cc[ij]
load T1:ec[bi]
load f:ec[bj]
.I:cc[ij] += f:ec[bj] T1:ec[bi]
drop f:ec[bj]
.R1:ec[ai] += -1 * I:cc[ij] T1:ec[aj]
