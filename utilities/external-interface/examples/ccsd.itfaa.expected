---- decl
index-space: a, External, e
index-space: b, External, e
index-space: c, External, e
index-space: d, External, e
index-space: i, Closed, c
index-space: j, Closed, c
index-space: k, Closed, c
index-space: l, Closed, c

tensor: ECC[], ECC

tensor: CSE1:ec[ai], !Create{type:disk}
tensor: CSE1:cccc[lkji], !Create{type:disk}
tensor: CSE2:ec[bi], !Create{type:disk}
tensor: CSE2:eccc[clki], !Create{type:disk}
tensor: CSE3:eecc[dbkj], !Create{type:disk}
tensor: CSE3:eccc[bkji], !Create{type:disk}
tensor: CSE4:eecc[bdlj], !Create{type:disk}
tensor: I:ee[bc], !Create{type:plain}
tensor: I:cc[ij], !Create{type:plain}
tensor: I:eecc[bcjk], !Create{type:plain}
tensor: I:eccc[bijk], !Create{type:plain}
tensor: I:cccc[ijkl], !Create{type:plain}
tensor: I2:eccc[cjkl], !Create{type:plain}
tensor: INTpp:eecc[bcij], INTpp:eecc
tensor: J:eeec[abcj], J:eeec
tensor: J:eecc[abij], J:eecc
tensor: K:eeee[abcd], K:eeee
tensor: K:eecc[abij], K:eecc
tensor: K:eccc[bijk], K:eccc
tensor: K:cccc[ijkl], K:cccc
tensor: R1:ec[ai], R1:ec
tensor: R2:eecc[abij], R2:eecc
tensor: R2u:eecc[abij], !Create{type:disk}
tensor: T1:ec[bj], T1:ec
tensor: T2:eecc[abij], T2:eecc
tensor: f:ee[ab], f:ee
tensor: f:ec[ai], f:ec
tensor: f:cc[ji], f:cc


---- code("Residual")
alloc CSE1:ec[ai]
load K:eecc[abij]
load T1:ec[bj]
.CSE1:ec[ai] += K:eecc[abij] T1:ec[bj]
drop T1:ec[bj]
drop K:eecc[abij]
store CSE1:ec[ai]

alloc CSE2:ec[bi]
load K:eecc[abij]
load T1:ec[aj]
.CSE2:ec[bi] += K:eecc[abij] T1:ec[aj]
drop T1:ec[aj]
drop K:eecc[abij]
store CSE2:ec[bi]

alloc ECC[]
load f:ec[ai]
load T1:ec[ai]
.ECC[] += 2 * f:ec[ai] T1:ec[ai]
drop T1:ec[ai]
drop f:ec[ai]
load K:eecc[abij]
load T2:eecc[abij]
.ECC[] += 2 * K:eecc[abij] T2:eecc[abij]
.ECC[] += -1 * K:eecc[abij] T2:eecc[abji]
drop T2:eecc[abji]
drop K:eecc[abij]
load T1:ec[ai]
load CSE1:ec[ai]
.ECC[] += 2 * T1:ec[ai] CSE1:ec[ai]
drop CSE1:ec[ai]
load CSE2:ec[bi]
.ECC[] += -1 * T1:ec[bi] CSE2:ec[bi]
drop CSE2:ec[bi]
drop T1:ec[bi]
store ECC[]

alloc CSE3:eccc[bkji]
load K:eecc[bcjk]
load T1:ec[ci]
.CSE3:eccc[bkji] += K:eecc[bcjk] T1:ec[ci]
drop T1:ec[ci]
drop K:eecc[bcjk]
store CSE3:eccc[bkji]

alloc R1:ec[ai]
load f:ee[ab]
load T1:ec[bi]
.R1:ec[ai] += f:ee[ab] T1:ec[bi]
drop T1:ec[bi]
drop f:ee[ab]
load f:ec[ai]
.R1:ec[ai] += f:ec[ai]
load T2:eecc[abij]
.R1:ec[ai] += 2 * f:ec[bj] T2:eecc[abij]
.R1:ec[ai] += -1 * f:ec[bj] T2:eecc[abji]
drop T2:eecc[abji]
drop f:ec[bj]
load f:cc[ji]
load T1:ec[aj]
.R1:ec[ai] += -1 * f:cc[ji] T1:ec[aj]
drop T1:ec[aj]
drop f:cc[ji]
load J:eeec[abcj]
load INTpp:eecc[bcij]
.R1:ec[ai] += 2 * J:eeec[abcj] INTpp:eecc[bcij]
.R1:ec[ai] += -1 * J:eeec[abcj] INTpp:eecc[cbij]
drop INTpp:eecc[cbij]
drop J:eeec[abcj]
load J:eecc[abij]
load T1:ec[bj]
.R1:ec[ai] += -1 * J:eecc[abij] T1:ec[bj]
drop T1:ec[bj]
drop J:eecc[abij]
load K:eecc[abij]
load T1:ec[bj]
.R1:ec[ai] += 2 * K:eecc[abij] T1:ec[bj]
drop T1:ec[bj]
drop K:eecc[abij]
load K:eccc[bijk]
load INTpp:eecc[abjk]
.R1:ec[ai] += K:eccc[bijk] INTpp:eecc[abjk]
.R1:ec[ai] += -2 * K:eccc[bijk] INTpp:eecc[abkj]
drop INTpp:eecc[abkj]
drop K:eccc[bijk]
alloc I:cc[ij]
load T1:ec[bi]
load f:ec[bj]
.I:cc[ij] += f:ec[bj] T1:ec[bi]
drop f:ec[bj]
.R1:ec[ai] += -1 * I:cc[ij] T1:ec[aj]
drop T1:ec[aj]
drop I:cc[ij]
alloc I:cc[ij]
load K:eecc[bcjk]
load INTpp:eecc[cbik]
.I:cc[ij] += K:eecc[bcjk] INTpp:eecc[cbik]
drop INTpp:eecc[cbik]
drop K:eecc[bcjk]
load T1:ec[aj]
.R1:ec[ai] += I:cc[ij] T1:ec[aj]
drop T1:ec[aj]
drop I:cc[ij]
alloc I:cc[ik]
load K:eecc[bcjk]
load INTpp:eecc[cbij]
.I:cc[ik] += K:eecc[bcjk] INTpp:eecc[cbij]
drop INTpp:eecc[cbij]
drop K:eecc[bcjk]
load T1:ec[ak]
.R1:ec[ai] += -2 * I:cc[ik] T1:ec[ak]
drop T1:ec[ak]
drop I:cc[ik]
load T2:eecc[abij]
load CSE1:ec[bj]
.R1:ec[ai] += 4 * T2:eecc[abij] CSE1:ec[bj]
drop CSE1:ec[bj]
load CSE3:eccc[bkji]
.R1:ec[ai] += T2:eecc[abjk] CSE3:eccc[bkji]
.R1:ec[ai] += -2 * T2:eecc[abkj] CSE3:eccc[bkji]
drop CSE3:eccc[bkji]
load CSE2:ec[cj]
.R1:ec[ai] += -2 * T2:eecc[acij] CSE2:ec[cj]
.R1:ec[ai] += T2:eecc[acji] CSE2:ec[cj]
drop CSE2:ec[cj]
load CSE1:ec[ck]
.R1:ec[ai] += -2 * T2:eecc[acki] CSE1:ec[ck]
drop CSE1:ec[ck]
drop T2:eecc[acki]
store R1:ec[ai]

for [j]:
	alloc CSE3:eecc[dbkj]
	load J:eeec[bcdk]
	load T1:ec[cj]
