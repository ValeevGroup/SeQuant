drop CSE3:eccc[bkji]
load K:eecc[abij]
load T1:ec[bj]
.R1:ec[ai] += 2 * K:eecc[abij] T1:ec[bj]
drop T1:ec[bj]
drop K:eecc[abij]
load CSE1:ec[cj]
