---- decl
index-space: a, External, e
index-space: b, External, e
index-space: c, External, e
index-space: d, External, e
index-space: i, Closed, c
index-space: j, Closed, c
index-space: k, Closed, c
index-space: l, Closed, c

tensor: ECC[], ECC

tensor: CSE1:ec[bj], !Create{type:disk}
tensor: CSE1:eccc[dkli], !Create{type:disk}
tensor: CSE2:ec[bj], !Create{type:disk}
tensor: CSE2:cccc[lkji], !Create{type:disk}
tensor: CSE3:eecc[dbkj], !Create{type:disk}
tensor: CSE3:eccc[cjki], !Create{type:disk}
tensor: CSE4:eecc[bdkj], !Create{type:disk}
tensor: CSE5:eecc[adli], !Create{type:disk}
tensor: I:ee[ad], !Create{type:plain}
tensor: I:cc[ij], !Create{type:plain}
tensor: I:eecc[acjk], !Create{type:plain}
tensor: I:eccc[bijk], !Create{type:plain}
tensor: I:cccc[ijkl], !Create{type:plain}
tensor: INTpp:eecc[bcij], INTpp:eecc
tensor: J:eeec[abcj], J:eeec
tensor: J:eecc[abij], J:eecc
tensor: K:eeee[abcd], K:eeee
tensor: K:eecc[abij], K:eecc
tensor: K:eccc[bijk], K:eccc
tensor: K:cccc[ijkl], K:cccc
tensor: R1:ec[ai], R1:ec
tensor: R2:eecc[abij], R2:eecc
tensor: R2u:eecc[abij], !Create{type:disk}
tensor: T1:ec[ai], T1:ec
tensor: T2:eecc[abij], T2:eecc
tensor: f:ee[ab], f:ee
tensor: f:ec[ai], f:ec
tensor: f:cc[ji], f:cc


---- code("Residual")
alloc CSE1:ec[bj]
load K:eecc[abij]
load T1:ec[ai]
.CSE1:ec[bj] += K:eecc[abij] T1:ec[ai]
drop T1:ec[ai]
drop K:eecc[abij]
store CSE1:ec[bj]

alloc CSE2:ec[bj]
load K:eecc[abji]
load T1:ec[ai]
.CSE2:ec[bj] += K:eecc[abji] T1:ec[ai]
drop T1:ec[ai]
drop K:eecc[abji]
store CSE2:ec[bj]

alloc ECC[]
load f:ec[ai]
load T1:ec[ai]
.ECC[] += 2 * f:ec[ai] T1:ec[ai]
drop T1:ec[ai]
drop f:ec[ai]
load K:eecc[abij]
load T2:eecc[abij]
.ECC[] += 2 * K:eecc[abij] T2:eecc[abij]
.ECC[] += -1 * K:eecc[abji] T2:eecc[abij]
drop T2:eecc[abij]
drop K:eecc[abji]
load T1:ec[bj]
load CSE1:ec[bj]
.ECC[] += 2 * T1:ec[bj] CSE1:ec[bj]
drop CSE1:ec[bj]
load CSE2:ec[bj]
.ECC[] += -1 * T1:ec[bj] CSE2:ec[bj]
drop CSE2:ec[bj]
drop T1:ec[bj]
store ECC[]

alloc CSE3:eccc[cjki]
load K:eecc[bcjk]
load T1:ec[bi]
.CSE3:eccc[cjki] += K:eecc[bcjk] T1:ec[bi]
drop T1:ec[bi]
drop K:eecc[bcjk]
store CSE3:eccc[cjki]

alloc R1:ec[ai]
