drop I:cc[ij]
load J:eecc[abij]
load T1:ec[bj]
.R1:ec[ai] += -1 * J:eecc[abij] T1:ec[bj]
drop T1:ec[bj]
drop J:eecc[abij]
store R1:ec[ai]

for [j]:
	alloc CSE2:eecc[dbkj]
	load J:eeec[bcdk]
