R1{a1;i1}:A-N-S =
  + f{a1;i1}:A-H-S
  - f{i2;i1}:A-H-S T1{a1;i2}:A-N-S
  + f{a1;a2}:A-H-S T1{a2;i1}:A-N-S
  + g{i2,a1;a2,i1}:A-H-S T1{a2;i2}:A-N-S
  + f{i2;a2}:A-H-S T2{a1,a2;i1,i2}:A-N-S
  + 1/2 g{i2,i3;a2,i1}:A-H-S INTpp{a1,a2;i2,i3}
  - 1/2 g{i2,a1;a2,a3}:A-H-S INTpp{a2,a3;i1,i2}
  - f{i2;a2}:A-H-S T1{a2;i1}:A-N-S T1{a1;i2}:A-N-S
  - 1/2 g{i2,i3;a2,a3}:A-H-S T1{a1;i2}:A-N-S INTpp{a2,a3;i1,i3}
  + 1/2 g{i2,i3;a2,a3}:A-H-S T2{a1,a2;i2,i3}:A-N-S T1{a3;i1}:A-N-S
  + g{i2,i3;a2,a3}:A-H-S T2{a1,a2;i1,i2}:A-N-S T1{a3;i3}:A-N-S
