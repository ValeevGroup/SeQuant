# Writes OUTPUT, a C++ source that defines the bytes of INPUT as
# sequant_schedule::schedule_view_template[] (unsigned char, so that bytes
# above 0x7f need no narrowing) together with their count, so that the viewer
# page travels inside the sequant-schedule binary.
file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" hex_length)
math(EXPR size "${hex_length} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
# sixteen bytes per line keeps every line short
string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n" bytes "${bytes}")
file(WRITE "${OUTPUT}" "// generated by embed.cmake from ${INPUT}; do not edit
#include <cstddef>

namespace sequant_schedule {
extern unsigned char const schedule_view_template[] = {
${bytes}};
extern std::size_t const schedule_view_template_size = ${size};
}  // namespace sequant_schedule
")
