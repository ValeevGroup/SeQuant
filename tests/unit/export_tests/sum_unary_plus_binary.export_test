f{a1;i1} - f{i2;i1} t{a1;i2} 


=================================================
Plain Text
=================================================
Declare index i_1
Declare index i_2
Declare index a_1

Declare tensor I[i_1, a_1]
Declare tensor f[i_2, i_1]
Declare tensor f[a_1, i_1]
Declare tensor t[a_1, i_2]

Create I[i_1, a_1] and initialize to zero
Load f[i_2, i_1]
Load t[a_1, i_2]
Compute I[i_1, a_1] += -1 f[i_2, i_1] t[a_1, i_2]
Unload t[a_1, i_2]
Unload f[i_2, i_1]
Load f[a_1, i_1]
Compute I[i_1, a_1] += f[a_1, i_1]
Unload f[a_1, i_1]
Persist I[i_1, a_1]

=================================================
Python (einsum)
=================================================
import numpy as np
import os

I_vo = np.zeros((nvirt, nocc), order='F')
f_oo = np.load('f_oo.npy')
t_vo = np.load('t_vo.npy')
I_vo += -1 * np.einsum('ia,bi->ba', f_oo, t_vo, optimize=True)
del t_vo
del f_oo
f_vo = np.load('f_vo.npy')
I_vo += np.einsum('ai->ai', f_vo, optimize=True)
del f_vo
np.save('I_vo.npy', I_vo)
del I_vo

=================================================
C (TAPP)
=================================================
/* Generated by SeQuant */

#include <stddef.h>
#include <stdint.h>
#include <stdlib.h>
#include <string.h>

#include <tapp.h>

typedef enum {
  SEQUANT_SUCCESS = 0,
  SEQUANT_TAPP_FAILURE,
  SEQUANT_OUT_OF_MEMORY,
  SEQUANT_IO_FAILURE
} sequant_status;

/* Caller-provided storage of tensors and variables, identified by name. Both
   callbacks transfer count elements and return 0 on success. */
typedef struct {
  int (*load)(void *user, const char *name, double *buffer, size_t count);
  int (*store)(void *user, const char *name, const double *buffer, size_t count);
  void *user;
} sequant_io;

/* Mode labels */
enum {
  SEQUANT_IDX_i_1,
  SEQUANT_IDX_i_2,
  SEQUANT_IDX_a_1
};

/* Extents of the index spaces */
typedef struct {
  int64_t nocc;
  int64_t nvirt;
} sequant_dims;

typedef struct {
  sequant_dims dims;
  TAPP_handle handle;
  TAPP_executor exec;
  /* Layout and number of elements of each tensor block */
  TAPP_tensor_info info_oo;
  size_t size_oo;
  TAPP_tensor_info info_ov;
  size_t size_ov;
  TAPP_tensor_info info_scalar;
  size_t size_scalar;
  TAPP_tensor_info info_vo;
  size_t size_vo;
  /* Tensor operations */
  TAPP_tensor_product plan_1; /* ov[i_1, a_1] += oo[i_2, i_1] vo[a_1, i_2] */
  TAPP_tensor_product plan_2; /* ov[i_1, a_1] += vo[a_1, i_1] */
} sequant_plans;

/* Error handling: the macros below expect the enclosing function to have the
   variables status and error as well as a cleanup label. */
#define SEQUANT_CHECK(call) \
  do { \
    TAPP_error tapp_error_ = (call); \
    if (!TAPP_check_success(tapp_error_)) { \
      if (error) *error = tapp_error_; \
      status = SEQUANT_TAPP_FAILURE; \
      goto cleanup; \
    } \
  } while (0)

#define SEQUANT_ALLOCATE(buffer, count) \
  do { \
    (buffer) = malloc((count) * sizeof *(buffer)); \
    if (!(buffer)) { \
      status = SEQUANT_OUT_OF_MEMORY; \
      goto cleanup; \
    } \
  } while (0)

#define SEQUANT_ALLOCATE_ZERO(buffer, count) \
  do { \
    (buffer) = calloc((count), sizeof *(buffer)); \
    if (!(buffer)) { \
      status = SEQUANT_OUT_OF_MEMORY; \
      goto cleanup; \
    } \
  } while (0)

#define SEQUANT_LOAD(name, buffer, count) \
  do { \
    if (io->load(io->user, (name), (buffer), (count)) != 0) { \
      status = SEQUANT_IO_FAILURE; \
      goto cleanup; \
    } \
  } while (0)

#define SEQUANT_STORE(name, buffer, count) \
  do { \
    if (io->store(io->user, (name), (buffer), (count)) != 0) { \
      status = SEQUANT_IO_FAILURE; \
      goto cleanup; \
    } \
  } while (0)

/* Computes the strides of a dense row-major tensor and returns its number of elements */
static size_t sequant_layout(int nmode, const int64_t *extents, int64_t *strides)
{
  size_t size = 1;
  for (int i = nmode - 1; i >= 0; --i) {
    strides[i] = (int64_t)size;
    size *= (size_t)extents[i];
  }
  return size;
}

void sequant_destroy_plans(sequant_plans *plans);

/* Creates all TAPP objects needed by the compute functions. On failure, nothing
   needs to be destroyed and, unless error is NULL, *error holds the failing TAPP
   error code. */
sequant_status sequant_create_plans(sequant_plans *plans, const sequant_dims *dims, TAPP_error *error)
{
  sequant_status status = SEQUANT_SUCCESS;

  memset(plans, 0, sizeof *plans);
  plans->dims = *dims;
  SEQUANT_CHECK(TAPP_create_handle(&plans->handle));
  SEQUANT_CHECK(TAPP_create_executor(&plans->exec));

  {
    const int64_t extents[2] = {dims->nocc, dims->nocc};
    int64_t strides[2];
    plans->size_oo = sequant_layout(2, extents, strides);
    SEQUANT_CHECK(TAPP_create_tensor_info(&plans->info_oo, TAPP_F64, 2, extents, strides));
  }

  {
    const int64_t extents[2] = {dims->nocc, dims->nvirt};
    int64_t strides[2];
    plans->size_ov = sequant_layout(2, extents, strides);
    SEQUANT_CHECK(TAPP_create_tensor_info(&plans->info_ov, TAPP_F64, 2, extents, strides));
  }

  SEQUANT_CHECK(TAPP_create_tensor_info(&plans->info_scalar, TAPP_F64, 0, NULL, NULL));
  plans->size_scalar = 1;

  {
    const int64_t extents[2] = {dims->nvirt, dims->nocc};
    int64_t strides[2];
    plans->size_vo = sequant_layout(2, extents, strides);
    SEQUANT_CHECK(TAPP_create_tensor_info(&plans->info_vo, TAPP_F64, 2, extents, strides));
  }

  {
    /* ov[i_1, a_1] += oo[i_2, i_1] vo[a_1, i_2] */
    static const int64_t idx_A[] = {SEQUANT_IDX_i_2, SEQUANT_IDX_i_1};
    static const int64_t idx_B[] = {SEQUANT_IDX_a_1, SEQUANT_IDX_i_2};
    static const int64_t idx_D[] = {SEQUANT_IDX_i_1, SEQUANT_IDX_a_1};
    SEQUANT_CHECK(TAPP_create_tensor_product(&plans->plan_1, plans->handle,
                                             TAPP_IDENTITY, plans->info_oo, idx_A,
                                             TAPP_IDENTITY, plans->info_vo, idx_B,
                                             TAPP_IDENTITY, plans->info_ov, idx_D,
                                             TAPP_IDENTITY, plans->info_ov, idx_D,
                                             TAPP_DEFAULT_PREC));
  }

  {
    /* ov[i_1, a_1] += vo[a_1, i_1] */
    static const int64_t idx_A[] = {SEQUANT_IDX_a_1, SEQUANT_IDX_i_1};
    static const int64_t idx_D[] = {SEQUANT_IDX_i_1, SEQUANT_IDX_a_1};
    SEQUANT_CHECK(TAPP_create_tensor_product(&plans->plan_2, plans->handle,
                                             TAPP_IDENTITY, plans->info_vo, idx_A,
                                             TAPP_IDENTITY, plans->info_scalar, NULL,
                                             TAPP_IDENTITY, plans->info_ov, idx_D,
                                             TAPP_IDENTITY, plans->info_ov, idx_D,
                                             TAPP_DEFAULT_PREC));
  }

  return status;

cleanup:
  sequant_destroy_plans(plans);
  return status;
}

/* Releases all TAPP objects of plans (which may be only partially created) */
void sequant_destroy_plans(sequant_plans *plans)
{
  if (plans->plan_2) TAPP_destroy_tensor_product(plans->plan_2);
  if (plans->plan_1) TAPP_destroy_tensor_product(plans->plan_1);
  if (plans->info_vo) TAPP_destroy_tensor_info(plans->info_vo);
  if (plans->info_scalar) TAPP_destroy_tensor_info(plans->info_scalar);
  if (plans->info_ov) TAPP_destroy_tensor_info(plans->info_ov);
  if (plans->info_oo) TAPP_destroy_tensor_info(plans->info_oo);
  if (plans->exec) TAPP_destroy_executor(plans->exec);
  if (plans->handle) TAPP_destroy_handle(plans->handle);
  memset(plans, 0, sizeof *plans);
}

sequant_status sequant_compute(const sequant_plans *plans, const sequant_io *io, TAPP_error *error)
{
  sequant_status status = SEQUANT_SUCCESS;
  const double one = 1.0;
  TAPP_status tapp_status = 0;
  double *I_ov = NULL;
  double *f_oo = NULL;
  double *f_vo = NULL;
  double *t_vo = NULL;

  SEQUANT_ALLOCATE_ZERO(I_ov, plans->size_ov);
  SEQUANT_ALLOCATE(f_oo, plans->size_oo);
  SEQUANT_LOAD("f_oo", f_oo, plans->size_oo);
  SEQUANT_ALLOCATE(t_vo, plans->size_vo);
  SEQUANT_LOAD("t_vo", t_vo, plans->size_vo);
  /* I[i_1, a_1] += -1.0 f[i_2, i_1] t[a_1, i_2] */
  {
    const double alpha = -1.0;
    SEQUANT_CHECK(TAPP_execute_product(plans->plan_1, plans->exec, &tapp_status,
                                       &alpha, f_oo, t_vo, &one, I_ov, I_ov));
  }
  free(t_vo);
  t_vo = NULL;
  free(f_oo);
  f_oo = NULL;
  SEQUANT_ALLOCATE(f_vo, plans->size_vo);
  SEQUANT_LOAD("f_vo", f_vo, plans->size_vo);
  /* I[i_1, a_1] += f[a_1, i_1] */
  SEQUANT_CHECK(TAPP_execute_product(plans->plan_2, plans->exec, &tapp_status,
                                     &one, f_vo, &one, &one, I_ov, I_ov));
  free(f_vo);
  f_vo = NULL;
  SEQUANT_STORE("I_ov", I_ov, plans->size_ov);
  free(I_ov);
  I_ov = NULL;

cleanup:
  free(I_ov);
  free(f_oo);
  free(f_vo);
  free(t_vo);
  return status;
}

