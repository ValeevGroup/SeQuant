#include <tapp.h>

typedef enum {
  SEQUANT_SUCCESS = 0,
  SEQUANT_TAPP_FAILURE,
  SEQUANT_OUT_OF_MEMORY,
  SEQUANT_IO_FAILURE
} sequant_status;

/* Caller-provided storage of tensors and variables, identified by name. Both
   callbacks transfer count elements and return 0 on success. */
typedef struct {
  int (*load)(void *user, const char *name, double *buffer, size_t count);
  int (*store)(void *user, const char *name, const double *buffer, size_t count);
  void *user;
} sequant_io;

/* Mode labels */
enum {
  SEQUANT_IDX_i_1,
  SEQUANT_IDX_i_2,
  SEQUANT_IDX_i_3,
  SEQUANT_IDX_a_1,
  SEQUANT_IDX_a_2,
  SEQUANT_IDX_a_3
};

/* Extents of the index spaces */
typedef struct {
  int64_t nocc;
  int64_t nvirt;
} sequant_dims;

typedef struct {
  sequant_dims dims;
  TAPP_handle handle;
  TAPP_executor exec;
  /* Layout and number of elements of each tensor block */
  TAPP_tensor_info info_oovv;
  size_t size_oovv;
  TAPP_tensor_info info_voov;
  size_t size_voov;
  TAPP_tensor_info info_vovo;
  size_t size_vovo;
  TAPP_tensor_info info_vvoo;
  size_t size_vvoo;
  /* Tensor operations */
  TAPP_tensor_product plan_1; /* oovv[i_1, i_2, a_1, a_2] += vovo[a_2, i_3, a_3, i_1] vvoo[a_1, a_3, i_3, i_2] */
  TAPP_tensor_product plan_2; /* oovv[i_1, i_2, a_1, a_2] += voov[a_1, i_3, i_1, a_3] vvoo[a_2, a_3, i_2, i_3] */
} sequant_plans;

/* Error handling: the macros below expect the enclosing function to have the
   variables status and error as well as a cleanup label. */
#define SEQUANT_CHECK(call) \
  do { \
    TAPP_error tapp_error_ = (call); \
    if (!TAPP_check_success(tapp_error_)) { \
      if (error) *error = tapp_error_; \
      status = SEQUANT_TAPP_FAILURE; \
      goto cleanup; \
    } \
  } while (0)

#define SEQUANT_ALLOCATE(buffer, count) \
  do { \
    (buffer) = malloc((count) * sizeof *(buffer)); \
    if (!(buffer)) { \
      status = SEQUANT_OUT_OF_MEMORY; \
      goto cleanup; \
    } \
  } while (0)

#define SEQUANT_ALLOCATE_ZERO(buffer, count) \
  do { \
    (buffer) = calloc((count), sizeof *(buffer)); \
    if (!(buffer)) { \
      status = SEQUANT_OUT_OF_MEMORY; \
      goto cleanup; \
    } \
  } while (0)

#define SEQUANT_LOAD(name, buffer, count) \
  do { \
    if (io->load(io->user, (name), (buffer), (count)) != 0) { \
      status = SEQUANT_IO_FAILURE; \
      goto cleanup; \
    } \
  } while (0)

#define SEQUANT_STORE(name, buffer, count) \
  do { \
    if (io->store(io->user, (name), (buffer), (count)) != 0) { \
      status = SEQUANT_IO_FAILURE; \
      goto cleanup; \
    } \
  } while (0)

/* Computes the strides of a dense row-major tensor and returns its number of elements */
static size_t sequant_layout(int nmode, const int64_t *extents, int64_t *strides)
{
  size_t size = 1;
  for (int i = nmode - 1; i >= 0; --i) {
    strides[i] = (int64_t)size;
    size *= (size_t)extents[i];
  }
  return size;
}

void sequant_destroy_plans(sequant_plans *plans);

/* Creates all TAPP objects needed by the compute functions. On failure, nothing
   needs to be destroyed and, unless error is NULL, *error holds the failing TAPP
   error code. */
sequant_status sequant_create_plans(sequant_plans *plans, const sequant_dims *dims, TAPP_error *error)
{
  sequant_status status = SEQUANT_SUCCESS;

  memset(plans, 0, sizeof *plans);
  plans->dims = *dims;
  SEQUANT_CHECK(TAPP_create_handle(&plans->handle));
  SEQUANT_CHECK(TAPP_create_executor(&plans->exec));

  {
    const int64_t extents[4] = {dims->nocc, dims->nocc, dims->nvirt, dims->nvirt};
    int64_t strides[4];
    plans->size_oovv = sequant_layout(4, extents, strides);
    SEQUANT_CHECK(TAPP_create_tensor_info(&plans->info_oovv, TAPP_F64, 4, extents, strides));
  }

  {
    const int64_t extents[4] = {dims->nvirt, dims->nocc, dims->nocc, dims->nvirt};
    int64_t strides[4];
    plans->size_voov = sequant_layout(4, extents, strides);
    SEQUANT_CHECK(TAPP_create_tensor_info(&plans->info_voov, TAPP_F64, 4, extents, strides));
  }

  {
    const int64_t extents[4] = {dims->nvirt, dims->nocc, dims->nvirt, dims->nocc};
    int64_t strides[4];
    plans->size_vovo = sequant_layout(4, extents, strides);
    SEQUANT_CHECK(TAPP_create_tensor_info(&plans->info_vovo, TAPP_F64, 4, extents, strides));
  }

  {
    const int64_t extents[4] = {dims->nvirt, dims->nvirt, dims->nocc, dims->nocc};
    int64_t strides[4];
    plans->size_vvoo = sequant_layout(4, extents, strides);
    SEQUANT_CHECK(TAPP_create_tensor_info(&plans->info_vvoo, TAPP_F64, 4, extents, strides));
  }

  {
    /* oovv[i_1, i_2, a_1, a_2] += vovo[a_2, i_3, a_3, i_1] vvoo[a_1, a_3, i_3, i_2] */
    static const int64_t idx_A[] = {SEQUANT_IDX_a_2, SEQUANT_IDX_i_3, SEQUANT_IDX_a_3, SEQUANT_IDX_i_1};
    static const int64_t idx_B[] = {SEQUANT_IDX_a_1, SEQUANT_IDX_a_3, SEQUANT_IDX_i_3, SEQUANT_IDX_i_2};
    static const int64_t idx_D[] = {SEQUANT_IDX_i_1, SEQUANT_IDX_i_2, SEQUANT_IDX_a_1, SEQUANT_IDX_a_2};
    SEQUANT_CHECK(TAPP_create_tensor_product(&plans->plan_1, plans->handle,
                                             TAPP_IDENTITY, plans->info_vovo, idx_A,
                                             TAPP_IDENTITY, plans->info_vvoo, idx_B,
                                             TAPP_IDENTITY, plans->info_oovv, idx_D,
                                             TAPP_IDENTITY, plans->info_oovv, idx_D,
                                             TAPP_DEFAULT_PREC));
  }

  {
    /* oovv[i_1, i_2, a_1, a_2] += voov[a_1, i_3, i_1, a_3] vvoo[a_2, a_3, i_2, i_3] */
    static const int64_t idx_A[] = {SEQUANT_IDX_a_1, SEQUANT_IDX_i_3, SEQUANT_IDX_i_1, SEQUANT_IDX_a_3};
    static const int64_t idx_B[] = {SEQUANT_IDX_a_2, SEQUANT_IDX_a_3, SEQUANT_IDX_i_2, SEQUANT_IDX_i_3};
    static const int64_t idx_D[] = {SEQUANT_IDX_i_1, SEQUANT_IDX_i_2, SEQUANT_IDX_a_1, SEQUANT_IDX_a_2};
    SEQUANT_CHECK(TAPP_create_tensor_product(&plans->plan_2, plans->handle,
                                             TAPP_IDENTITY, plans->info_voov, idx_A,
                                             TAPP_IDENTITY, plans->info_vvoo, idx_B,
                                             TAPP_IDENTITY, plans->info_oovv, idx_D,
                                             TAPP_IDENTITY, plans->info_oovv, idx_D,
                                             TAPP_DEFAULT_PREC));
  }

  return status;

cleanup:
  sequant_destroy_plans(plans);
  return status;
}

/* Releases all TAPP objects of plans (which may be only partially created) */
void sequant_destroy_plans(sequant_plans *plans)
{
  if (plans->plan_2) TAPP_destroy_tensor_product(plans->plan_2);
  if (plans->plan_1) TAPP_destroy_tensor_product(plans->plan_1);
  if (plans->info_vvoo) TAPP_destroy_tensor_info(plans->info_vvoo);
  if (plans->info_vovo) TAPP_destroy_tensor_info(plans->info_vovo);
  if (plans->info_voov) TAPP_destroy_tensor_info(plans->info_voov);
  if (plans->info_oovv) TAPP_destroy_tensor_info(plans->info_oovv);
  if (plans->exec) TAPP_destroy_executor(plans->exec);
  if (plans->handle) TAPP_destroy_handle(plans->handle);
  memset(plans, 0, sizeof *plans);
}

sequant_status sequant_compute(const sequant_plans *plans, const sequant_io *io, TAPP_error *error)
{
  sequant_status status = SEQUANT_SUCCESS;
  const double one = 1.0;
  TAPP_status tapp_status = 0;
  double *I_oovv = NULL;
  double *g_voov = NULL;
  double *g_vovo = NULL;
  double *t_vvoo = NULL;

  SEQUANT_ALLOCATE_ZERO(I_oovv, plans->size_oovv);
  SEQUANT_ALLOCATE(g_vovo, plans->size_vovo);
  SEQUANT_LOAD("g_vovo", g_vovo, plans->size_vovo);
  SEQUANT_ALLOCATE(t_vvoo, plans->size_vvoo);
  SEQUANT_LOAD("t_vvoo", t_vvoo, plans->size_vvoo);
  /* I[i_1, i_2, a_1, a_2] += -1.0 g[a_2, i_3, a_3, i_1] t[a_1, a_3, i_3, i_2] */
  {
    const double alpha = -1.0;
    SEQUANT_CHECK(TAPP_execute_product(plans->plan_1, plans->exec, &tapp_status,
                                       &alpha, g_vovo, t_vvoo, &one, I_oovv, I_oovv));
  }
  free(t_vvoo);
  t_vvoo = NULL;
  free(g_vovo);
  g_vovo = NULL;
  SEQUANT_ALLOCATE(g_voov, plans->size_voov);
  SEQUANT_LOAD("g_voov", g_voov, plans->size_voov);
  SEQUANT_ALLOCATE(t_vvoo, plans->size_vvoo);
  SEQUANT_LOAD("t_vvoo", t_vvoo, plans->size_vvoo);
  /* I[i_1, i_2, a_1, a_2] += 2.0 g[a_1, i_3, i_1, a_3] t[a_2, a_3, i_2, i_3] */
  {
    const double alpha = 2.0;
    SEQUANT_CHECK(TAPP_execute_product(plans->plan_2, plans->exec, &tapp_status,
                                       &alpha, g_voov, t_vvoo, &one, I_oovv, I_oovv));
  }
  free(t_vvoo);
  t_vvoo = NULL;
  free(g_voov);
  g_voov = NULL;
  SEQUANT_STORE("I_oovv", I_oovv, plans->size_oovv);
  free(I_oovv);
  I_oovv = NULL;

cleanup:
  free(I_oovv);
  free(g_voov);
  free(g_vovo);
  free(t_vvoo);
  return status;
}

