  /* Tensor operations */
  TAPP_tensor_product plan_1; /* vv[a_1, a_2] += vo[a_2, i_2] ov[i_2, a_1] */
} sequant_plans;

/* Error handling: the macros below expect the enclosing function to have the
   variables status and error as well as a cleanup label. */
#define SEQUANT_CHECK(call) \
  do { \
    TAPP_error tapp_error_ = (call); \
    if (!TAPP_check_success(tapp_error_)) { \
      if (error) *error = tapp_error_; \
