/* Computes the strides of a dense row-major tensor and returns its number of elements */
static size_t sequant_layout(int nmode, const int64_t *extents, int64_t *strides)
{
  size_t size = 1;
  for (int i = nmode - 1; i >= 0; --i) {
    strides[i] = (int64_t)size;
    size *= (size_t)extents[i];
  }
  return size;
}

void sequant_destroy_plans(sequant_plans *plans);

/* Creates all TAPP objects needed by the compute functions. On failure, nothing
   needs to be destroyed and, unless error is NULL, *error holds the failing TAPP
   error code. */
sequant_status sequant_create_plans(sequant_plans *plans, const sequant_dims *dims, TAPP_error *error)
{
  sequant_status status = SEQUANT_SUCCESS;

  memset(plans, 0, sizeof *plans);
  plans->dims = *dims;
  SEQUANT_CHECK(TAPP_create_handle(&plans->handle));
  SEQUANT_CHECK(TAPP_create_executor(&plans->exec));

  {
    const int64_t extents[2] = {dims->nocc, dims->nvirt};
    int64_t strides[2];
    plans->size_ov = sequant_layout(2, extents, strides);
    SEQUANT_CHECK(TAPP_create_tensor_info(&plans->info_ov, TAPP_F64, 2, extents, strides));
  }

  {
    const int64_t extents[2] = {dims->nvirt, dims->nocc};
    int64_t strides[2];
    plans->size_vo = sequant_layout(2, extents, strides);
    SEQUANT_CHECK(TAPP_create_tensor_info(&plans->info_vo, TAPP_F64, 2, extents, strides));
  }

  {
    const int64_t extents[2] = {dims->nvirt, dims->nvirt};
    int64_t strides[2];
    plans->size_vv = sequant_layout(2, extents, strides);
    SEQUANT_CHECK(TAPP_create_tensor_info(&plans->info_vv, TAPP_F64, 2, extents, strides));
  }

  {
    /* vv[a_1, a_2] += vo[a_2, i_2] ov[i_2, a_1] */
    static const int64_t idx_A[] = {SEQUANT_IDX_a_2, SEQUANT_IDX_i_2};
    static const int64_t idx_B[] = {SEQUANT_IDX_i_2, SEQUANT_IDX_a_1};
    static const int64_t idx_D[] = {SEQUANT_IDX_a_1, SEQUANT_IDX_a_2};
    SEQUANT_CHECK(TAPP_create_tensor_product(&plans->plan_1, plans->handle,
                                             TAPP_IDENTITY, plans->info_vo, idx_A,
                                             TAPP_IDENTITY, plans->info_ov, idx_B,
                                             TAPP_IDENTITY, plans->info_vv, idx_D,
                                             TAPP_IDENTITY, plans->info_vv, idx_D,
                                             TAPP_DEFAULT_PREC));
  }

  return status;

cleanup:
  sequant_destroy_plans(plans);
  return status;
}

/* Releases all TAPP objects of plans (which may be only partially created) */
void sequant_destroy_plans(sequant_plans *plans)
{
  if (plans->plan_1) TAPP_destroy_tensor_product(plans->plan_1);
  if (plans->info_vv) TAPP_destroy_tensor_info(plans->info_vv);
  if (plans->info_vo) TAPP_destroy_tensor_info(plans->info_vo);
  if (plans->info_ov) TAPP_destroy_tensor_info(plans->info_ov);
  if (plans->exec) TAPP_destroy_executor(plans->exec);
  if (plans->handle) TAPP_destroy_handle(plans->handle);
  memset(plans, 0, sizeof *plans);
}

sequant_status sequant_compute(const sequant_plans *plans, const sequant_io *io, TAPP_error *error)
{
  sequant_status status = SEQUANT_SUCCESS;
  const double one = 1.0;
  TAPP_status tapp_status = 0;
  double *A_vo = NULL;
  double *B_ov = NULL;
  double *I_vv = NULL;

  SEQUANT_ALLOCATE_ZERO(I_vv, plans->size_vv);
  SEQUANT_ALLOCATE(A_vo, plans->size_vo);
  SEQUANT_LOAD("A_vo", A_vo, plans->size_vo);
  SEQUANT_ALLOCATE(B_ov, plans->size_ov);
  SEQUANT_LOAD("B_ov", B_ov, plans->size_ov);
  /* I[a_1, a_2] += 5.0 A[a_2, i_2] B[i_2, a_1] */
  {
    const double alpha = 5.0;
    SEQUANT_CHECK(TAPP_execute_product(plans->plan_1, plans->exec, &tapp_status,
                                       &alpha, A_vo, B_ov, &one, I_vv, I_vv));
  }
  free(B_ov);
  B_ov = NULL;
  free(A_vo);
  A_vo = NULL;
  SEQUANT_STORE("I_vv", I_vv, plans->size_vv);
  free(I_vv);
  I_vv = NULL;

cleanup:
  free(A_vo);
  free(B_ov);
  free(I_vv);
  return status;
}

