  SEQUANT_TAPP_FAILURE,
  SEQUANT_OUT_OF_MEMORY,
  SEQUANT_IO_FAILURE
} sequant_status;

/* Caller-provided storage of tensors and variables, identified by name. Both
   callbacks transfer count elements and return 0 on success. */
typedef struct {
  int (*load)(void *user, const char *name, double *buffer, size_t count);
  int (*store)(void *user, const char *name, const double *buffer, size_t count);
  void *user;
} sequant_io;

/* Mode labels */
enum {
  SEQUANT_IDX_i_2,
  SEQUANT_IDX_a_1,
  SEQUANT_IDX_a_2
};

