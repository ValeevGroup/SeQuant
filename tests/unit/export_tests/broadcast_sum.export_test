D{i_1;a_1} = ε{;a_1} - ε{i_1;}

=================================================
Plain Text
=================================================
Declare index i_1
Declare index a_1

Declare tensor D[i_1, a_1]
Declare tensor ε[i_1]
Declare tensor ε[a_1]

Create D[i_1, a_1] and initialize to zero
Load ε[i_1]
Compute D[i_1, a_1] += -1 ε[i_1] (broadcast over a_1)
Unload ε[i_1]
Load ε[a_1]
Compute D[i_1, a_1] += ε[a_1] (broadcast over i_1)
Unload ε[a_1]
Persist D[i_1, a_1]

=================================================
Julia (TensorOperations)
=================================================
D_ov = zeros(Float64, nocc, nv)
ε_o = deserialize("ε_o.jlbin")
D_ov .+= -1 * reshape(ε_o, (nocc, 1))
ε_o = nothing
ε_v = deserialize("ε_v.jlbin")
D_ov .+= reshape(ε_v, (1, nv))
ε_v = nothing
return D_ov

=================================================
Python (einsum)
=================================================
import numpy as np
import os

D_ov = np.zeros((nocc, nvirt), order='F')
ε_o = np.load('ε_o.npy')
D_ov += -1 * np.einsum('i->i', ε_o, optimize=True)[:, None]
del ε_o
ε_v = np.load('ε_v.npy')
D_ov += np.einsum('a->a', ε_v, optimize=True)[None, :]
del ε_v
np.save('D_ov.npy', D_ov)

=================================================
PyTorch (einsum)
=================================================
import torch
import os

D_ov = torch.zeros((nocc, nvirt), dtype=torch.float64)
ε_o = torch.load('ε_o.pt')
D_ov += -1 * torch.einsum('i->i', ε_o)[:, None]
del ε_o
ε_v = torch.load('ε_v.pt')
D_ov += torch.einsum('a->a', ε_v)[None, :]
del ε_v
torch.save(D_ov, 'D_ov.pt')

