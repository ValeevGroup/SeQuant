R{a1;i1} = t{a1;a2} f{a2;i2} f{i2;i1}
S{a1;i1} = v{a1;a2} f{a2;i2} f{i2;i1}
U{a1;i1} = t{a1;a2} f{a2;i2} v{i2;i1}
R{a1;i1} = v{a1;i2} f{i2;i1}

