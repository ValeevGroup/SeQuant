R{i_1;a_1} = 2 f{i_1;a_1} D{i_1;a_1}:S-S-S^(-1)

=================================================
Plain Text
=================================================
Declare index i_1
Declare index a_1

Declare tensor D[a_1, i_1]
Declare tensor I[i_1, a_1]
Declare tensor R[i_1, a_1]
Declare tensor f[i_1, a_1]

Create R[i_1, a_1] and initialize to zero
Create I[i_1, a_1] and initialize to zero
Load D[a_1, i_1]
Compute I[i_1, a_1] += D[a_1, i_1]^(-1)
Unload D[a_1, i_1]
Load f[i_1, a_1]
Compute R[i_1, a_1] += 2 I[i_1, a_1] f[i_1, a_1]
Unload f[i_1, a_1]
Unload I[i_1, a_1]
Persist R[i_1, a_1]

=================================================
Julia (TensorOperations)
=================================================
R_ov = zeros(Float64, nocc, nv)
I_vo = zeros(Float64, nv, nocc)
D_vo = deserialize("D_vo.jlbin")
I_vo .+= D_vo .^ (-1)
D_vo = nothing
f_ov = deserialize("f_ov.jlbin")
@tensor R_ov[ i_1, a_1 ] += 2 * I_vo[ a_1, i_1 ] * f_ov[ i_1, a_1 ]
f_ov = nothing
I_vo = nothing
return R_ov

=================================================
Python (einsum)
=================================================
import numpy as np
import os

R_ov = np.zeros((nocc, nvirt), order='F')
I_vo = np.zeros((nvirt, nocc), order='F')
D_vo = np.load('D_vo.npy')
I_vo += np.einsum('ai->ai', D_vo, optimize=True)**(-1)
del D_vo
f_ov = np.load('f_ov.npy')
R_ov += 2 * np.einsum('ai,ia->ia', I_vo, f_ov, optimize=True)
del f_ov
del I_vo
np.save('R_ov.npy', R_ov)

=================================================
PyTorch (einsum)
=================================================
import torch
import os

R_ov = torch.zeros((nocc, nvirt), dtype=torch.float64)
I_ov = torch.zeros((nocc, nvirt), dtype=torch.float64)
D_ov = torch.load('D_ov.pt')
I_ov += torch.einsum('ia->ia', D_ov)**(-1)
del D_ov
f_ov = torch.load('f_ov.pt')
R_ov += 2 * torch.einsum('ia,ia->ia', I_ov, f_ov)
del f_ov
del I_ov
torch.save(R_ov, 'R_ov.pt')

