section s:
X{i1,a1;a2,i2} = t{i1;a2} v{a1;i2}
R{a1;i1} = X{i2,a1;a2,i1} f{a2;i2}

=================================================
ITF
point_group: D2
irreps: t:B1, f:A, v:B2
=================================================
---- decl
index-space: j, Closed, c
index-space: k, Closed, c
index-space: b, External, e
index-space: c, External, e

tensor: R:ec[bj], R:ec // irrep:B3
tensor: X:ceec[jbck], !Create{type:disk; irrep:B3}
tensor: f:ec[ck], f:ec // irrep:A
tensor: t:ce[jc], t:ce // irrep:B1
tensor: v:ec[bk], v:ec // irrep:B2


---- code("s")
alloc X:ceec[jbck]
load t:ce[jc]
load v:ec[bk]
.X:ceec[jbck] += t:ce[jc] v:ec[bk]
drop v:ec[bk]
drop t:ce[jc]
store X:ceec[jbck]

alloc R:ec[bj]
load X:ceec[kbcj]
load f:ec[ck]
.R:ec[bj] += X:ceec[kbcj] f:ec[ck]
drop f:ec[ck]
drop X:ceec[kbcj]
store R:ec[bj]


---- end

